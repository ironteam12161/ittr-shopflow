# ITTR ShopFlow settings. On Railway, set these under the service's Variables; locally, copy this file to .env.
# Never commit real values. Only the "Required" block is needed to start; everything else turns a feature on.
# See docs/GO-LIVE.md for the launch checklist.

# ---- Required ----
NODE_ENV=production
# Railway sets PORT itself; locally the app uses 3000.
PORT=3000
# Railway: reference the Postgres service (${{Postgres.DATABASE_URL}}). The private *.railway.internal address needs no SSL.
DATABASE_URL=postgresql://...
# Creates the first owner account on an empty database only (at least 10 characters). Change the password after the
# first sign-in (🔒 Password), then you may remove BOOTSTRAP_ADMIN_PASSWORD; it is never used again once an owner exists.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
# The public address of the site. Used in customer links (estimate approval, portal, inspections), emails and the
# Gmail sign-in redirect. Example: https://shop.ironttr.com
APP_PUBLIC_URL=

# ---- General (optional) ----
SESSION_TTL_DAYS=7
# Used for "today", reminders and dates printed on emails.
SHOP_TIMEZONE=America/Chicago
# Slack / Discord / Microsoft Teams incoming-webhook URL for server error alerts.
ALERT_WEBHOOK_URL=
# How long a stopping server (on each deploy) may finish running requests, in milliseconds. Railway may stop it sooner
# unless its "Draining seconds" setting is raised.
# ITTR_SHUTDOWN_GRACE_MS=10000
# Database certificate check for an external database (leave unset on Railway's private network).
# ITTR_DB_SSL_VERIFY=1
# PGSSLROOTCERT=/path/to/ca.pem
# Last resort if an owner/manager lost both their authenticator phone and recovery codes: set to their username,
# restart once, then remove it again.
# ITTR_RESET_2FA=

# ---- Shop branding on invoice PDFs and emails (optional) ----
SHOP_NAME=Iron Team Truck & Trailer Repair
SHOP_TAGLINE=Heavy-Duty Truck & Trailer Service
SHOP_ADDRESS1=12161 S Central Ave
SHOP_ADDRESS2=Alsip, IL 60803
SHOP_PHONE=(847) 636-0852
SHOP_EMAIL=contact@example.com
SHOP_WEBSITE=
SHOP_ACCENT_COLOR=#c2410c

# ---- Customer invoice email through Resend (optional; the Gmail sender below is the other choice) ----
# Verify the sending domain in Resend first and use a From address on it.
RESEND_API_KEY=
INVOICE_FROM_EMAIL=Iron Team Truck & Trailer Repair <invoices@example.com>
INVOICE_REPLY_TO=service@example.com

# ---- Gmail: send email as the shop, and the read-only money inbox for Zelle notices and vendor bills (optional) ----
# Google Cloud OAuth "Web application" client with the Gmail API enabled. Redirect URI:
#   ${APP_PUBLIC_URL}/api/gmail/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; defaults to APP_PUBLIC_URL + /api/gmail/oauth/callback
GOOGLE_REDIRECT_URI=
# Long random secret that encrypts Gmail tokens at rest. Keep it stable: changing it disconnects Gmail.
GMAIL_TOKEN_KEY=

# ---- Online card payments through Stripe (optional) ----
# "Pay online" links on invoices. The webhook records paid invoices automatically: in Stripe, add an endpoint
#   ${APP_PUBLIC_URL}/api/stripe/webhook   (event: checkout.session.completed)
# and copy its signing secret here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Texting customers through Twilio (optional) ----
# Set the number's "A message comes in" webhook to ${APP_PUBLIC_URL}/api/sms/inbound (HTTP POST).
# US numbers need A2P 10DLC registration in Twilio before texts are delivered.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either a Twilio number (+1…) or a messaging service.
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# ---- Finding photos in Cloudflare R2 (optional; without it photos cannot be uploaded) ----
R2_BUCKET_NAME=ittr-shop-photos
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto

# ---- Fleet mileage from Samsara (optional) ----
SAMSARA_API_TOKEN=

# ---- Carrier lookup by USDOT (optional) ----
# Official FMCSA QCMobile API WebKey.
FMCSA_WEBKEY=

# ---- AI assistance (optional, server-side keys only) ----
# Free provider preferred
OPENROUTER_API_KEY=
AI_PROVIDER=auto
OPENROUTER_MODEL=openrouter/free
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
