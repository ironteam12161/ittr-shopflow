# Local development / hosted environment variables
PORT=3000
NODE_ENV=production
DATABASE_URL=postgresql://...
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
SESSION_TTL_DAYS=7
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Cloudflare R2 private finding photo storage
R2_BUCKET_NAME=ittr-shop-photos
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto

# Preferred free AI provider (server-side only)
OPENROUTER_API_KEY=
AI_PROVIDER=auto
OPENROUTER_MODEL=openrouter/free
# Optional public URL sent as OpenRouter HTTP-Referer metadata
APP_PUBLIC_URL=
