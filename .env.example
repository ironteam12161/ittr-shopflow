# Local development / hosted environment variables
PORT=3000
NODE_ENV=production
DATABASE_URL=postgresql://...
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
SESSION_TTL_DAYS=7
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Cloudflare R2 private finding photo storage
R2_BUCKET_NAME=ittr-shop-photos
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto

# Preferred free AI provider (server-side only)
OPENROUTER_API_KEY=
AI_PROVIDER=auto
OPENROUTER_MODEL=openrouter/free
# Optional public URL sent as OpenRouter HTTP-Referer metadata
APP_PUBLIC_URL=

# Customer invoice email (Resend). Verify the sending domain first.
# Keep the API key server-side and use a From address on the verified domain.
RESEND_API_KEY=re_...
INVOICE_FROM_EMAIL=Iron Team Truck & Trailer Repair <invoices@example.com>
INVOICE_REPLY_TO=service@example.com
# Optional shop branding shared by invoice PDFs and emails
SHOP_NAME=Iron Team Truck & Trailer Repair
SHOP_TAGLINE=Heavy-Duty Truck & Trailer Service
SHOP_ADDRESS1=12161 S Central Ave
SHOP_ADDRESS2=Alsip, IL 60803
SHOP_PHONE=(847) 636-0852
SHOP_EMAIL=contact@example.com
SHOP_WEBSITE=
SHOP_ACCENT_COLOR=#c2410c

# Official FMCSA QCMobile API WebKey (keep server-side only)
FMCSA_WEBKEY=

# Gmail money inbox (Zelle notices + vendor bills, read-only). Create a Google Cloud OAuth
# "Web application" client, enable the Gmail API, and add this redirect URI:
#   ${APP_PUBLIC_URL}/api/gmail/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; defaults to APP_PUBLIC_URL + /api/gmail/oauth/callback
GOOGLE_REDIRECT_URI=
# Long random secret used to encrypt Gmail refresh tokens at rest (keep it stable)
GMAIL_TOKEN_KEY=
